<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         account.journal — Form view extension
         Adds a "Dual Bookkeeping" notebook page with sequence stat buttons.
         ================================================================ -->
    <record id="view_account_journal_form_dual_bookkeeping" model="ir.ui.view">
        <field name="name">account.journal.form.dual.bookkeeping</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">

            <!-- Stat buttons: NO Sequence and O Sequence -->
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">

                <button class="oe_stat_button"
                        type="object"
                        name="action_open_no_sequence"
                        icon="fa-list-ol"
                        invisible="not sequence_no_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">NO Sequence</span>
                        <field name="sequence_no_id" readonly="1" nolabel="1"
                               options="{'no_open': True, 'no_create': True}"/>
                    </div>
                </button>

                <button class="oe_stat_button"
                        type="object"
                        name="action_open_o_sequence"
                        icon="fa-bookmark"
                        invisible="not sequence_o_master_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">O Sequence</span>
                        <field name="sequence_o_master_id" readonly="1" nolabel="1"
                               options="{'no_open': True, 'no_create': True}"/>
                    </div>
                </button>

            </xpath>

            <!-- Dual Bookkeeping notebook page -->
            <xpath expr="//notebook" position="inside">
                <page string="Dual Bookkeeping" name="dual_bookkeeping">

                    <group string="Official Journal Mapping">
                        <group>
                            <!-- Invisible helper so the domain below can reference a flat field -->
                            <field name="journal_official_company_id" invisible="1"/>
                            <field name="official_journal_id"
                                   domain="[('company_id', '=', journal_official_company_id)]"
                                   options="{'no_create': True}"
                                   help="Select the corresponding journal in the official company. Its sequence_o_id will be used as the master Official sequence for all companies."/>
                            <field name="has_dual_sequence" readonly="1"/>
                        </group>
                    </group>

                    <group string="Sequence Details" col="2">
                        <group string="Official (O) Sequence">
                            <field name="sequence_o_id" readonly="1"
                                   string="Local O Sequence"
                                   options="{'no_open': False, 'no_create': True}"/>
                            <field name="sequence_o_master_id" readonly="1"
                                   string="Active O Master"
                                   options="{'no_open': False, 'no_create': True}"/>
                        </group>
                        <group string="Non-Official (NO) Sequence">
                            <field name="sequence_no_id" readonly="1"
                                   options="{'no_open': False, 'no_create': True}"/>
                        </group>
                    </group>

                    <div class="alert alert-info" role="alert"
                         invisible="official_journal_id">
                        <strong>No Official Journal mapped.</strong>
                        Official transactions in this journal will use the local sequence
                        as a fallback. Use
                        <em>Accounting &gt; Dual Bookkeeping &gt; Link Official Journals</em>
                        to configure the mapping.
                    </div>

                </page>
            </xpath>

        </field>
    </record>

</odoo>
