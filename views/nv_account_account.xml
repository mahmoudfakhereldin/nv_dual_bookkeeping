<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         account.journal — Form view extension
         Adds a "Dual Bookkeeping" notebook page with sequence stat buttons.
         ================================================================ -->
    <record id="view_account_account_form_dual_bookkeeping" model="ir.ui.view">
        <field name="name">account.account.form.dual.bookkeeping</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='account_type']" position="after">
               <field name="sap_code"/>
            </xpath>

        </field>
    </record>

</odoo>
